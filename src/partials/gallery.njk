<!-- Gallery -->
<section class="section section-gallery bg-light" id="gallery">
    <div class="container">
        <h2>{{ gallery.heading }}</h2>
        {% if gallery.intro %}<p class="section-intro">{{ gallery.intro }}</p>{% endif %}
        <div class="grid">
            {% for image in gallery.images %}
            <div class="card">{% image image.src, image.alt, "", "(max-width: 700px) 100vw, 400px", "lazy" %}</div>
            {% endfor %}
        </div>
    </div>
</section>
